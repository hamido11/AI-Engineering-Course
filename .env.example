OPENAI_API_KEY=sk-...

# Models are configurable on purpose: providers retire models over time.
# Pick a current chat model from OpenAI's models page and set it here.
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-haiku-5-5
VOYAGE_MODEL=voyage-4

# Grader for Lab 12 (defaults to CHAT_MODEL; a stronger model is better)
# JUDGE_MODEL=
# Fallback model for Lab 13 (defaults to CHAT_MODEL)
# FALLBACK_MODEL=

# Optional: copy from the provider's pricing page so the cost ledger shows real dollars
# PRICE_IN_PER_M=0.00
# PRICE_OUT_PER_M=0.00
